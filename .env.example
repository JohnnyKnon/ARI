# ARI Platform - 환경변수 템플릿
# 이 파일을 복사하여 .env로 사용하세요: cp .env.example .env

# ──────────────────────────────────────────────
# 서버 설정
# ──────────────────────────────────────────────
NODE_ENV=development
SERVER_PORT=4000

# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ari_db
DB_USER=ari_user
DB_PASSWORD=CHANGE_ME_secure_password_here

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ──────────────────────────────────────────────
# RabbitMQ
# ──────────────────────────────────────────────
RABBITMQ_USER=ari_mq
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password_here
RABBITMQ_VHOST=ari
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://ari_mq:CHANGE_ME_rabbitmq_password_here@localhost:5672/ari

# ──────────────────────────────────────────────
# JWT 설정
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ──────────────────────────────────────────────
# 스토리지 설정
# ──────────────────────────────────────────────
# local | s3 | gcs (추후 확장)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# S3 설정 (STORAGE_PROVIDER=s3 일 때 활성화)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET=ari-audio-bucket

# ──────────────────────────────────────────────
# CORS 설정
# ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ──────────────────────────────────────────────
# 소셜 로그인 (추후 활성화)
# ──────────────────────────────────────────────
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_CALLBACK_URL=http://localhost:4000/api/v1/auth/kakao/callback

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/apple/callback

# ──────────────────────────────────────────────
# 워터마킹 설정
# ──────────────────────────────────────────────
WATERMARK_ALGORITHM_VERSION=1.0.0
WATERMARK_STRENGTH=medium
